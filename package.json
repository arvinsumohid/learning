{
  "name": "learning",
  "version": "1.0.0",
  "private": true,
  "description": "Runnable examples for software engineering learning topics.",
  "scripts": {
    "start:idempotency": "node idempotency/example-app.js",
    "start:idempotency:3002": "node idempotency/example-app.js --port 3002",
    "check:idempotency": "node --check idempotency/example-app.js",
    "start:rate-limiting": "node rate-limiting/example-app.js",
    "start:rate-limiting:3003": "node rate-limiting/example-app.js --port 3003",
    "check:rate-limiting": "node --check rate-limiting/example-app.js",
    "start:google-authentication": "node google-authentication/example-app.js",
    "start:google-authentication:3004": "node google-authentication/example-app.js --port 3004",
    "check:google-authentication": "node --check google-authentication/example-app.js",
    "start:aws": "node aws/example-app.js",
    "start:aws:3005": "node aws/example-app.js --port 3005",
    "check:aws": "node --check aws/example-app.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.18.3",
    "google-auth-library": "^10.6.2"
  }
}
