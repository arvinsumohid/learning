# Local server
PORT=3005

# S3 target
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# AWS credentials for real S3 SDK usage.
# The current learning example runs in local memory, but these are the
# credentials normally needed when replacing the local store with S3.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Optional, only needed for temporary STS/session credentials.
AWS_SESSION_TOKEN=

